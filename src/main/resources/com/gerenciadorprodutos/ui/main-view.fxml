<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gerenciadorprodutos.ui.MainController">
    <top>
        <VBox styleClass="cabecalho">
            <HBox styleClass="barra-titulo" alignment="CENTER_LEFT" spacing="12">
                <VBox>
                    <Label text="Gerenciador de Produtos" styleClass="titulo-app"/>
                    <Label text="Controle de estoque em tempo real" styleClass="subtitulo-app"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnTema" text="Modo escuro" styleClass="botao-secundario" onAction="#alternarTema"/>
            </HBox>
            <HBox styleClass="cartoes" spacing="16">
                <VBox styleClass="cartao">
                    <Label text="PRODUTOS CADASTRADOS" styleClass="cartao-rotulo"/>
                    <Label fx:id="lblTotalProdutos" text="0" styleClass="cartao-valor"/>
                </VBox>
                <VBox styleClass="cartao">
                    <Label text="ESTOQUE BAIXO / ESGOTADO" styleClass="cartao-rotulo"/>
                    <Label fx:id="lblEstoqueBaixo" text="0" styleClass="cartao-valor, cartao-valor-alerta"/>
                </VBox>
                <VBox styleClass="cartao">
                    <Label text="VALOR TOTAL EM ESTOQUE" styleClass="cartao-rotulo"/>
                    <Label fx:id="lblValorTotal" text="R$ 0,00" styleClass="cartao-valor, cartao-valor-destaque"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox styleClass="conteudo" spacing="20">
            <VBox styleClass="painel-formulario" spacing="14" prefWidth="290">
                <Label text="Dados do produto" styleClass="painel-titulo"/>
                <VBox spacing="4">
                    <Label text="Nome" styleClass="campo-rotulo"/>
                    <TextField fx:id="campoNome" promptText="Ex.: Detergente neutro"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Categoria" styleClass="campo-rotulo"/>
                    <TextField fx:id="campoCategoria" promptText="Ex.: Limpeza"/>
                </VBox>
                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Quantidade" styleClass="campo-rotulo"/>
                        <TextField fx:id="campoQuantidade" promptText="0"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Preco (R$)" styleClass="campo-rotulo"/>
                        <TextField fx:id="campoPreco" promptText="0,00"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblErro" styleClass="mensagem-erro" wrapText="true" managed="false" visible="false"/>
                <VBox spacing="8" styleClass="botoes-formulario">
                    <Button fx:id="btnAdicionar" text="Adicionar produto" styleClass="botao-primario" maxWidth="Infinity" onAction="#adicionarProduto"/>
                    <Button fx:id="btnAtualizar" text="Atualizar selecionado" styleClass="botao-secundario" maxWidth="Infinity" onAction="#atualizarProduto"/>
                    <Button fx:id="btnExcluir" text="Excluir selecionado" styleClass="botao-perigo" maxWidth="Infinity" onAction="#excluirProduto"/>
                    <Button fx:id="btnLimpar" text="Limpar campos" styleClass="botao-texto" maxWidth="Infinity" onAction="#limparCampos"/>
                </VBox>
            </VBox>
            <VBox styleClass="painel-tabela" spacing="10" HBox.hgrow="ALWAYS">
                <TextField fx:id="campoBusca" promptText="Buscar por nome..." styleClass="campo-busca"/>
                <TableView fx:id="tabela" styleClass="tabela-produtos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colunaId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colunaNome" text="Produto" prefWidth="170"/>
                        <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="110"/>
                        <TableColumn fx:id="colunaQuantidade" text="Qtd." prefWidth="60"/>
                        <TableColumn fx:id="colunaPreco" text="Preco" prefWidth="95"/>
                        <TableColumn fx:id="colunaValorTotal" text="Valor total" prefWidth="105"/>
                        <TableColumn fx:id="colunaStatus" text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox styleClass="rodape" alignment="CENTER_LEFT">
            <Label fx:id="lblStatusBar" text="Pronto."/>
        </HBox>
    </bottom>
    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</BorderPane>
